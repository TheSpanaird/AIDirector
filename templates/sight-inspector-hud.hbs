<div class="ai-director-hud-container" style="display: flex; flex-direction: column; gap: 8px; padding: 6px;">

  <!-- Dual Dropdown Control Bar -->
  <div class="ai-director-controls" style="display: flex; gap: 6px;">
    
    <!-- Mode Dropdown -->
    <div style="flex: 1;">
      <label style="font-weight: bold; font-size: 11px; display: block; margin-bottom: 2px;">Sight Mode:</label>
      <select id="ai-director-mode-select" style="width: 100%; height: 26px; font-size: 11px;">
        {{#each modes}}
          <option value="{{this.key}}" {{#if (eq ../selectedMode this.key)}}selected{{/if}}>
            {{this.label}}
          </option>
        {{/each}}
      </select>
    </div>

    <!-- Visible Target Dropdown -->
    <div style="flex: 1.5;">
      <label style="font-weight: bold; font-size: 11px; display: block; margin-bottom: 2px;">Target Line-of-Sight:</label>
      <select id="ai-director-sector-select" style="width: 100%; height: 26px; font-size: 11px;" {{#unless hasSectors}}disabled{{/unless}}>
        {{#if hasSectors}}
          {{#each visibleSectors}}
            <option value="{{this.sectorId}}" {{#if (eq ../selectedSectorId this.sectorId)}}selected{{/if}}>
              {{this.name}}
            </option>
          {{/each}}
        {{else}}
          <option value="">No Visible Sectors</option>
        {{/if}}
      </select>
    </div>

  </div>

  <!-- Viewport Stage with Vent / Window Mask Modifiers -->
  <div class="ai-director-viewport" style="position: relative; width: 100%; height: 220px; background: #000; border: 1px solid #4a6b82; border-radius: 4px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
    
    {{#if activeImagePath}}
      <img src="{{activeImagePath}}" style="width: 100%; height: 100%; object-fit: cover;" />
      
      <!-- Vent Overlay Mask applied client-side when mode === 'vent' -->
      {{#if (eq selectedMode "vent")}}
        <div class="vent-mask-overlay" style="position: absolute; top:0; left:0; right:0; bottom:0; background: repeating-linear-gradient(0deg, rgba(0,0,0,0.85), rgba(0,0,0,0.85) 8px, transparent 8px, transparent 20px); pointer-events: none; border: 12px solid #1a1a1a;"></div>
      {{/if}}

      <!-- Window Lens Effect applied client-side when mode === 'window' -->
      {{#if (eq selectedMode "window")}}
        <div class="window-mask-overlay" style="position: absolute; top:0; left:0; right:0; bottom:0; box-shadow: inset 0 0 40px rgba(255,255,255,0.25); border: 4px solid rgba(255,255,255,0.3); pointer-events: none;"></div>
      {{/if}}

    {{else}}
      <div style="color: #888; text-align: center; font-size: 12px; padding: 10px;">
        <i class="fas fa-eye-slash" style="font-size: 24px; display: block; margin-bottom: 6px;"></i>
        No pre-rendered scenery available.
      </div>
    {{/if}}

  </div>

  <!-- Action Bar -->
  <div style="display: flex; gap: 6px;">
    <button type="button" class="ai-director-forge-btn" style="flex: 1; background: #2b5235; color: #fff; border: 1px solid #4a8258; font-size: 11px;">
      <i class="fas fa-cog"></i> Forge / Re-render Sector
    </button>
    <button type="button" class="ai-director-popout-trigger" data-src="{{activeImagePath}}" style="flex: 1; background: #2a3e50; color: #fff; border: 1px solid #4a6b82; font-size: 11px;" {{#unless activeImagePath}}disabled{{/unless}}>
      <i class="fas fa-expand"></i> Expand View
    </button>
  </div>

</div>