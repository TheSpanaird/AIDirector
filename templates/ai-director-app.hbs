{{!-- modules/ai-director/templates/ai-director-app.hbs --}}

<div class="ai-director-main-window-frame">
  <nav class="director-sidebar-nav" data-group="primary">
    <div class="sidebar-brand">
      <i class="fas fa-cube" aria-hidden="true"></i>
    </div>

    <a class="nav-item active" data-tab="dashboard">AI Core</a>
    <a class="nav-item" data-tab="ledger">Dungeon Ledger</a>
    <a class="nav-item" data-tab="cartographer">Cartographer</a>
    <a class="nav-item" data-tab="persona">Persona</a>
    <a class="nav-item" data-tab="relations">Relations</a>
    <a class="nav-item" data-tab="rag">RAG Library</a>
    <a class="nav-item" data-tab="chaos">Chaos Matrix</a>
    <a class="nav-item" data-tab="tension">Combat Tension</a>
    <a class="nav-item" data-tab="journal">Journal</a>
  </nav>

  <section class="content-area">
    <div class="tab active" data-tab="dashboard" data-group="primary">
      {{!-- Core Dashboard Content View --}}
      {{> core-dashboard}}

      {{!-- Bottom mechanics component modifiers panel --}}
      <div
        class="director-action-modifiers"
        style="margin-top: 12px; padding: 10px; background: rgba(0,0,0,0.1); border: 1px solid var(--color-border-dark); border-radius: 4px;"
      >
        <div
          style="display: flex; gap: 15px; align-items: center; justify-content: space-between; flex-wrap: wrap;"
        >
          <div style="flex: 2; min-width: 220px;">
            <label
              style="display: block; font-size: var(--font-size-11); font-weight: bold; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.8;"
            >
              Enforced Override Skill
            </label>

            <select
              name="actionSkill"
              style="width: 100%; height: 26px; background: var(--color-bg); color: var(--color-text-dark); border: 1px solid var(--color-border-light-2);"
            >
              <option value="none" selected>
                N/A (Use AI Managed Evaluation)
              </option>

              {{#each systemSkills}}
                <option value="{{this.id}}">
                  {{this.name}}
                </option>
              {{/each}}
            </select>
          </div>

          <div
            style="display: flex; align-items: center; gap: 8px; padding-top: 16px;"
          >
            <input
              type="checkbox"
              name="actionBlindRoll"
              id="actionBlindRoll"
              style="margin: 0; cursor: pointer;"
            >

            <label
              for="actionBlindRoll"
              style="font-size: var(--font-size-11); font-weight: bold; cursor: pointer; text-transform: uppercase; opacity: 0.8;"
            >
              Secret Check (Blind)
            </label>
          </div>
        </div>
      </div>
    </div>

    <div class="tab" data-tab="ledger" data-group="primary">
      {{> dungeon-ledger}}
    </div>

    <div class="tab" data-tab="cartographer" data-group="primary">
      {{> cartographer-panel}}
    </div>

    <div class="tab" data-tab="persona" data-group="primary">
      {{> persona-engine}}
    </div>

    <div class="tab" data-tab="relations" data-group="primary">
      {{> relation-hub}}
    </div>

    <div class="tab" data-tab="rag" data-group="primary">
      {{> rag-library}}
    </div>

    <div class="tab" data-tab="chaos" data-group="primary">
      {{> chaos-matrix}}
    </div>

    <div class="tab" data-tab="tension" data-group="primary">
      {{> combat-tension}}
    </div>

    <div class="tab" data-tab="journal" data-group="primary">
      {{> journal-log}}
    </div>
  </section>
</div>
